FROM gcr.io/oss-fuzz-base/base-builder

RUN apt-get update && \
    apt-get install -y cmake

RUN git clone --depth 1 https://github.com/richgel999/miniz.git

WORKDIR miniz
COPY run_tests.sh build.sh $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh /src/miniz/tests/small_fuzzer.c
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh small_fuzzer.c 56c7ced4eae78520e8c6b2a8b8b6b8071837deea && rm -f /tmp/qf_scrub_git.sh
