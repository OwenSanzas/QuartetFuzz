FROM gcr.io/oss-fuzz-base/base-builder:ubuntu-24-04
RUN git clone --depth 1 https://github.com/avahi/avahi
WORKDIR avahi
COPY build.sh $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh fuzz-strlst.c
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh fuzz-strlst.c e00d0fcb46f806802ede4c7a3a9696e745fb16bd && rm -f /tmp/qf_scrub_git.sh
