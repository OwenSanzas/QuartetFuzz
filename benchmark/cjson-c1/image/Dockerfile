FROM gcr.io/oss-fuzz-base/base-builder


RUN apt-get update && apt-get install -y cmake

RUN git clone --depth 1 https://github.com/DaveGamble/cJSON.git cjson

WORKDIR cjson
COPY build.sh run_tests.sh $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh cjson_read_fuzzer.c
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh cjson_read_fuzzer.c aa9c7ba7e759f3bc0ca94641632ad3f0808b78d4 && rm -f /tmp/qf_scrub_git.sh
