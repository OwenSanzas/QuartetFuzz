FROM gcr.io/oss-fuzz-base/base-builder
# RUN apt-get update && apt-get install -y make autoconf automake libtool
RUN git clone --depth 1 https://github.com/stephenberry/glaze
WORKDIR glaze
COPY build.sh run_tests.sh $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh /src/glaze/fuzzing/json_jmespath.cpp
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh json_jmespath.cpp ee9d27568c78e6fe9b1f787e4946870ba7b232b7 && rm -f /tmp/qf_scrub_git.sh
