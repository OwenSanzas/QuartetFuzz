FROM gcr.io/oss-fuzz-base/base-builder
RUN apt-get update && apt-get install -y g++ python

RUN git clone --recursive https://github.com/boostorg/boost.git
WORKDIR boost
# Preferably, move boost_regex_fuzzer.cc to the boost repository.
COPY build.sh *.zip *.cc $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh /src/boost_regex_replace_fuzzer.cc
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh boost_regex_replace_fuzzer.cc a94474673a56a7b3e4f472a247f0014e00909031 && rm -f /tmp/qf_scrub_git.sh
