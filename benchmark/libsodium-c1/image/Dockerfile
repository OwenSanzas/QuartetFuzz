FROM gcr.io/oss-fuzz-base/base-builder
RUN apt-get update && apt-get install -y make
RUN git clone --depth 1 https://github.com/jedisct1/libsodium.git --branch stable libsodium
WORKDIR libsodium
COPY run_tests.sh build.sh *.cc *.h $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh /src/crypto_sign_fuzzer.cc
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh crypto_sign_fuzzer.cc 8116c0edd579652ed93a1080c8c6a8da0e5237fb && rm -f /tmp/qf_scrub_git.sh
