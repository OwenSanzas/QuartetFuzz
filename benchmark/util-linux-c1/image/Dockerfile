FROM gcr.io/oss-fuzz-base/base-builder
RUN apt-get update && apt-get install -y autoconf automake autopoint bison flex libtool pkg-config
RUN git clone --depth 1 https://github.com/util-linux/util-linux
WORKDIR util-linux
COPY build.sh $SRC/

# --- QuartetFuzz baseline setup (pinned revisions, gold stubbed) ---
COPY qf /qf
RUN bash /qf/pin.sh
RUN bash /qf/stub.sh /src/util-linux/libfdisk/src/script.c
RUN apt-get update -q

# --- QuartetFuzz: remove the gold harness from git history ---
COPY qf_scrub_git.sh /tmp/qf_scrub_git.sh
RUN bash /tmp/qf_scrub_git.sh script.c 4b72ca70acaf3c7b66adb971bcb0f364435e3fbc && rm -f /tmp/qf_scrub_git.sh
